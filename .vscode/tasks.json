{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MinimalShot: Capture UI screenshots",
      "detail": "UI確認用のページ撮影を一括実行し、成功したらPNGの出力フォルダを開く",
      "type": "process",
      "command": "pwsh.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "pnpm readme:shots --open; exit $LASTEXITCODE"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": { "clear": true, "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      // dev版を取得して C:\Applications\bins の MinimalShot.exe を差し替え、起動中のものは止めてから再起動する
      // スクリプトは User 設定フォルダの scripts/update-minimalshot.ps1 を参照する
      "label": "MinimalShot: Update dev build and restart",
      "type": "process",
      "command": "pwsh.exe",
      "args": ["-NoLogo", "-NoProfile", "-File", "${env:APPDATA}\\Code\\User\\scripts\\update-minimalshot.ps1"],
      "presentation": { "clear": true, "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
